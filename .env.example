# Host-install defaults. The management UI listens on loopback only.
# Docker Compose overrides the bind for the container network namespace.
# Do not set EXPOSE_PUBLIC=1 on a host install unless you intend to publish the UI.

PORT_WARDEN_SECRET_KEY=replace-with-a-long-random-string
PORT_WARDEN_ADMIN_USERNAME=admin
PORT_WARDEN_ADMIN_PASSWORD=replace-with-12-plus-characters
PORT_WARDEN_BIND_HOST=127.0.0.1
PORT_WARDEN_BIND_PORT=8443
PORT_WARDEN_EXPOSE_PUBLIC=0
PORT_WARDEN_COOKIE_SECURE=0
# Leave empty for HTTP. Docker Compose points these at the build-time certificate.
PORT_WARDEN_SSL_CERTFILE=
PORT_WARDEN_SSL_KEYFILE=
PORT_WARDEN_DATABASE_URL=sqlite:///./data/port-warden.sqlite
PORT_WARDEN_DATA_DIR=./data

# disabled: stage rules only. local: this process calls nft (needs host network + NET_ADMIN).
# agent: unix socket helper. Docker Compose default is local on the host network.
PORT_WARDEN_NFT_BACKEND=local
PORT_WARDEN_NFT_BIN=nft
PORT_WARDEN_HOST_NETWORK=1
PORT_WARDEN_AGENT_SOCKET=/run/port-warden/apply.sock
PORT_WARDEN_AGENT_TOKEN_FILE=/etc/port-warden/agent.token

PORT_WARDEN_FIREWALL_MODE=enforce
# Put your admin source CIDR here before the first enforce Apply, or you can lose SSH.
PORT_WARDEN_MANAGEMENT_CIDRS=127.0.0.1/32,::1/128
# Optional fallback only. Live sshd detection wins when the Ports inventory can see processes.
PORT_WARDEN_SSH_PORT=22
PORT_WARDEN_EXCLUDED_PORTS=

PORT_WARDEN_LOG_RETENTION_DAYS=30
PORT_WARDEN_LOG_MAX_BYTES=5000000

PORT_WARDEN_BF_THRESHOLD=5
PORT_WARDEN_BF_WINDOW_SECONDS=600
PORT_WARDEN_BF_BAN_SECONDS=3600
PORT_WARDEN_BF_COOLDOWN_SECONDS=600
PORT_WARDEN_BF_PERMANENT_AFTER=0
PORT_WARDEN_AUTH_LOG_PATH=
PORT_WARDEN_BAN_AUTO_APPLY=0

# Comma-separated operator-owned host:port pairs. Empty disables the check.
PORT_WARDEN_REACHABILITY_TARGETS=
PORT_WARDEN_LOGIN_RATE_LIMIT=5
PORT_WARDEN_LOGIN_RATE_WINDOW=300
